/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "rootDir": "./src",              /* פותר את האזהרה לגבי common source directory */
    "moduleResolution": "bundler",    /* פותר את האזהרה לגבי node10 */
    "ignoreDeprecations": "6.0",      /* פותר את האזהרות לגבי baseUrl ו-downlevelIteration */
    "types": [
      "jasmine"
    ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}